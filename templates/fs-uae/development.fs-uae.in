# AmiDevIDE development machine -- GENERATED by bootstrap/acd_gen_config.py.
# Do not edit; edit templates/fs-uae/development.fs-uae.in and re-run acd-config.
#
# Layout is identical on macOS, Linux and Windows:
#   DH0    = Workbench 3.1 hard disk image
#   SHARED = the host directory the IDE copies freshly built binaries into
#
# A1200, Kickstart 3.1, 2 MB Chip + 8 MB Fast RAM.

[fs-uae]
amiga_model = A1200

chip_memory = 2048
fast_memory = 8192
zorro_iii_memory = 0

kickstart_file = @ACD_KICKSTART@

hard_drive_0 = @ACD_WORKBENCH_HDF@
hard_drive_0_label = DH0
hard_drive_0_read_only = 0

hard_drive_1 = @ACD_SHARED@
hard_drive_1_label = SHARED
hard_drive_1_read_only = 0

# Program output: everything an Amiga program writes to the serial port ends up
# in this file, which the IDE tails into its Output pane.  Harmless if unused.
serial_port = @ACD_SERIAL_LOG@

window_width = 1024
window_height = 768
fullscreen = 0
scanlines = 0
rtg_scanlines = 0

accuracy = 1
cpu_idle = 0
debug_memory = 0
gfx_debug = 0

joystick_port_0 = Mouse
joystick_port_1_mode = mouse

audio_frequency = 44100
audio_buffer_target_size = 40
