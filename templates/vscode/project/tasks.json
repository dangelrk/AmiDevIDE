{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project (Makefile)",
            "type": "shell",
            "command": "make",
            "windows": {
                "command": "C:/msys64/usr/bin/bash.exe",
                "args": [
                    "-lc",
                    "cd \"$(cygpath -u \"${workspaceFolder}\")\" && make"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "vbcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):\\s+(warning|error)\\s+\\d+:\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Clean Project",
            "type": "shell",
            "command": "make",
            "args": [
                "clean"
            ],
            "windows": {
                "command": "C:/msys64/usr/bin/bash.exe",
                "args": [
                    "-lc",
                    "cd \"$(cygpath -u \"${workspaceFolder}\")\" && make clean"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Rebuild Project",
            "type": "shell",
            "command": "make",
            "args": [
                "clean",
                "all"
            ],
            "windows": {
                "command": "C:/msys64/usr/bin/bash.exe",
                "args": [
                    "-lc",
                    "cd \"$(cygpath -u \"${workspaceFolder}\")\" && make clean && make"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": {
                "owner": "vbcc",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):\\s+(warning|error)\\s+\\d+:\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        }
    ]
}