# AmiDevIDE environment -- GENERATED by bootstrap/acd_gen_config.py.
# Do not edit; edit templates/setenv/setenv.sh.in and re-run acd-config.
#
# Usage:  source @ACD_TOOLCHAIN@/setenv.sh

export VBCC=@ACD_TOOLCHAIN@
export PATH="$VBCC/bin:$PATH"

# vbcc C runtime for m68k-amigaos
export VBCC_INC=$VBCC/targets/m68k-amigaos/include
export VBCC_LIB=$VBCC/targets/m68k-amigaos/lib

# Amiga NDK 3.2 (note: 3.2 is NEWER than 3.9 -- NDK 3.9 is not used here)
export NDK32_INC=$VBCC/sdk/NDK_3.2/Include_H
export NDK32_ASM_INC=$VBCC/sdk/NDK_3.2/Include_I
export NDK32_LIB=$VBCC/sdk/NDK_3.2/lib

# MUI 3.8 GUI toolkit + third-party MCC classes
export MUI38_INC=$VBCC/sdk/MUI_3.8/Developer/C/Include
export MCC_INC=$VBCC/sdk/MCC/Developer/C/include

# Small system libraries used by the MUI frontend of the IDE
export REGEX_INC=$VBCC/sdk/regex/include
export REQTOOLS_INC=$VBCC/sdk/reqtools/include

# Roadshow TCP/IP
export TCP_INC=$VBCC/sdk/Roadshow/include
export NET_INC=$VBCC/sdk/Roadshow/netinclude

# AmiSSL v5
export AMISSL_INC=$VBCC/sdk/AmiSSL-v5/Developer/include
export AMISSL_LIB=$VBCC/sdk/AmiSSL-v5/Developer/lib/AmigaOS3

# Misc
export POSIXLIB_INC=$VBCC/sdk/PosixLib/include
export SQLITE_INC=$VBCC/sdk/SQLite3/include
export SQLITE_LIB=$VBCC/sdk/SQLite3/lib

# ACE BASIC cross-compiler (bin/{ace,yap,bas}, driver config in config/ace68k).
# bas reads config/ace68k on its own; these are here so the paths are visible
# and so single tools can be run by hand.
export ACE_HOME=$VBCC/sdk/ACE
export ACE_LIB=$ACE_HOME/lib
export ACE_INC=$ACE_HOME/include
export ACE_BMAPS=$ACE_HOME/bmaps
