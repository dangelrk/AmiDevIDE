# AmiDevIDE environment -- GENERATED by bootstrap/acd_gen_config.py.
# Do not edit; edit templates/setenv/setenv.ps1.in and re-run acd-config.
#
# Usage:  . @ACD_TOOLCHAIN_WIN@\setenv.ps1

$env:VBCC = "@ACD_TOOLCHAIN_WIN@"
$env:PATH = "$env:VBCC\bin;$env:PATH"

# vbcc C runtime for m68k-amigaos
$env:VBCC_INC = "$env:VBCC\targets\m68k-amigaos\include"
$env:VBCC_LIB = "$env:VBCC\targets\m68k-amigaos\lib"

# Amiga NDK 3.2
$env:NDK32_INC     = "$env:VBCC\sdk\NDK_3.2\Include_H"
$env:NDK32_ASM_INC = "$env:VBCC\sdk\NDK_3.2\Include_I"
$env:NDK32_LIB     = "$env:VBCC\sdk\NDK_3.2\lib"

# MUI 3.8 GUI toolkit + third-party MCC classes
$env:MUI38_INC = "$env:VBCC\sdk\MUI_3.8\Developer\C\Include"
$env:MCC_INC   = "$env:VBCC\sdk\MCC\Developer\C\include"

# Small system libraries used by the MUI frontend of the IDE
$env:REGEX_INC    = "$env:VBCC\sdk\regex\include"
$env:REQTOOLS_INC = "$env:VBCC\sdk\reqtools\include"

# Roadshow TCP/IP
$env:TCP_INC = "$env:VBCC\sdk\Roadshow\include"
$env:NET_INC = "$env:VBCC\sdk\Roadshow\netinclude"

# AmiSSL v5
$env:AMISSL_INC = "$env:VBCC\sdk\AmiSSL-v5\Developer\include"
$env:AMISSL_LIB = "$env:VBCC\sdk\AmiSSL-v5\Developer\lib\AmigaOS3"

# Misc
$env:POSIXLIB_INC = "$env:VBCC\sdk\PosixLib\include"
$env:SQLITE_INC   = "$env:VBCC\sdk\SQLite3\include"
$env:SQLITE_LIB   = "$env:VBCC\sdk\SQLite3\lib"

# ACE BASIC cross-compiler
$env:ACE_HOME  = "$env:VBCC\sdk\ACE"
$env:ACE_LIB   = "$env:ACE_HOME\lib"
$env:ACE_INC   = "$env:ACE_HOME\include"
$env:ACE_BMAPS = "$env:ACE_HOME\bmaps"
