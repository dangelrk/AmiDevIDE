 /* ---- Limits (same as yap.b) ---- */
 #define MAX_MACROS           2048
 #define MAX_MACRO_NAME       48
@@ -135,7 +149,8 @@ int ch;
 
 static void show_usage()
 {
- printf("YAP - Yet Another Preprocessor for ACE BASIC\n");
+ printf("YAP - Yet Another Preprocessor for ACE BASIC %s build %s (%s)\n",
+	YAP_VERSION,ACE_BUILD_NUMBER,ACE_BUILD_DATE);
  printf("Usage: yap [options] <inputfile> <outputfile>\n");
  printf("\n");
  printf("Options:\n");
@@ -145,6 +160,7 @@ static void show_usage()
  printf("  -I<path>        Add include search path\n");
  printf("  -g              Emit #line markers so ace reports positions\n");
  printf("                  in the original source\n");
+ printf("  -V              Show version and exit\n");
 }
 
 /*---- macro table ---------------------------------------------------------*/
@@ -947,6 +963,11 @@ char **argv;
 		genLineMarkers = TRUE;
 		break;
 
+	 case 'V':
+		printf("yap %s build %s (%s)\n",
+		       YAP_VERSION,ACE_BUILD_NUMBER,ACE_BUILD_DATE);
+		exit(0);
+
 	 case 'D':
 		if (a[2] == '\0')
 		   { printf("Error: -D requires a macro name\n"); return(FALSE); }
