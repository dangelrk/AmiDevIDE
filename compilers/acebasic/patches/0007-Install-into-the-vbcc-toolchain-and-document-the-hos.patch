+### Host Installation (Cross-Compiler)
+
+ACE also builds as a native host toolchain, so Amiga executables can be
+produced on macOS, Linux or Windows without an Amiga or an emulator. It slots
+into the vbcc cross-compiler that supplies `vasmm68k_mot` and `vlink`:
+
+```bash
+export VBCC=~/Dev/amiga            # the vbcc toolchain root
+cd src/make
+make -f Makefile-host              # build ace, yap and bas for the host
+make -f Makefile-host install      # install into $VBCC
+```
+
+That puts `ace`, `yap` and `bas` in `$VBCC/bin`, a driver configuration in
+`$VBCC/config/ace68k`, and the runtime libraries, bmaps, headers, icons and
+submodules under `$VBCC/sdk/ACE`. Afterwards:
+
+```bash
+source ~/Dev/amiga/setenv_mac.sh   # or setenv_lin.sh / setenv_win.sh
+bas myprogram.b                    # -> myprogram, an AmigaOS executable
+```
+
+The host `bas` takes the same options as the Amiga script and reads the same
+`REM #using` and `OPTION 2-` directives from the source. AmigaDOS assigns in
+`#using` paths (`ace:`, `acelib:`, `aceinclude:`, `acebmaps:`, `acesubmods:`)
+are mapped onto the installed directories, so existing sources build
+unchanged.
+
+Paths can be overridden with `ACE_HOME`, `ACE_LIB`, `ACE_INC`, `ACE_BMAPS`
+and `ACE_BIN`; `ace` and `yap` honour `ACE_BMAPS` and `ACE_INC` when run
+directly. The native AmigaOS build is unaffected — see
+`make -f Makefile-host amiga-check`, which cross-builds the compiler for m68k
+to confirm that code path still compiles.
+
 ## Building
 
 ### Building the ACE Compiler
diff --git a/src/make/Makefile-host b/src/make/Makefile-host
index 67e21c0..daeb557 100644
--- a/src/make/Makefile-host
+++ b/src/make/Makefile-host
@@ -189,6 +189,63 @@ $(AMIGA_DIR)/%.o: $(ACE_SRC_DIR)/%.c $(ACE_SRC_DIR)/acedef.h
 	$(ECHO) "Compiling $< (m68k)..."
 	$(Q)VBCC="$(VBCC)" PATH="$(VBCC)/bin:$$PATH" $(VC) $(AMIGA_CFLAGS) $< -o $@
 
+################################################################################
+# INSTALL
+################################################################################
+# Slots ACE into the vbcc toolchain the way its other components are laid
+# out: binaries flat in bin/, driver config in config/, everything else as
+# an SDK under sdk/ACE keeping its own directory names.
+#
+#   $(VBCC)/bin/{ace,yap,bas}
+#   $(VBCC)/config/ace68k
+#   $(VBCC)/sdk/ACE/{lib,bmaps,include,icons,submods}
+#
+# submods/ is installed because sources reference their objects through the
+# ace: assign ("REM #using ace:submods/list/list.o"), which bas maps onto
+# $(ACE_HOME).
+
+INSTALL_BIN = $(VBCC)/bin
+INSTALL_CFG = $(VBCC)/config
+INSTALL_SDK = $(VBCC)/sdk/ACE
+
+install: all
+	@echo "Installing into $(VBCC) ..."
+	$(Q)mkdir -p $(INSTALL_BIN) $(INSTALL_CFG)
+	$(Q)mkdir -p $(INSTALL_SDK)/lib $(INSTALL_SDK)/bmaps \
+	             $(INSTALL_SDK)/include $(INSTALL_SDK)/icons \
+	             $(INSTALL_SDK)/submods
+	$(ECHO) "  bin/"
+	$(Q)cp $(ACE_BIN) $(YAP_BIN) $(BAS_BIN) $(INSTALL_BIN)/
+	$(ECHO) "  sdk/ACE/"
+	$(Q)cp -R $(ROOT)/lib/. $(INSTALL_SDK)/lib/
+	$(Q)cp -R $(ROOT)/bmaps/. $(INSTALL_SDK)/bmaps/
+	$(Q)cp -R $(ROOT)/include/. $(INSTALL_SDK)/include/
+	$(Q)cp -R $(ROOT)/icons/. $(INSTALL_SDK)/icons/
+	$(Q)cp -R $(ROOT)/submods/. $(INSTALL_SDK)/submods/
+	$(ECHO) "  config/ace68k"
+	$(Q)printf '%s\n' \
+	  '# ACE BASIC driver configuration, read by bas.' \
+	  '# Generated by src/make/Makefile-host install - edit freely.' \
+	  '#' \
+	  '# Environment variables override these:' \
+	  '#   ACE_HOME ACE_LIB ACE_INC ACE_BMAPS ACE_BIN' \
+	  '' \
+	  'yap     = $(INSTALL_BIN)/yap' \
+	  'ace     = $(INSTALL_BIN)/ace' \
+	  'vasm    = $(INSTALL_BIN)/vasmm68k_mot' \
+	  'vlink   = $(INSTALL_BIN)/vlink' \
+	  '' \
+	  'homedir = $(INSTALL_SDK)' \
+	  'libdir  = $(INSTALL_SDK)/lib' \
+	  'incdir  = $(INSTALL_SDK)/include' \
+	  'bmapdir = $(INSTALL_SDK)/bmaps' \
+	  > $(INSTALL_CFG)/ace68k
+	@echo ""
+	@echo "Installed. To use:"
+	@echo "  export VBCC=$(VBCC)"
+	@echo "  export PATH=\$$VBCC/bin:\$$PATH"
+	@echo "  bas myprog.b"
+
 ################################################################################
 # UTILITY TARGETS
 ################################################################################
