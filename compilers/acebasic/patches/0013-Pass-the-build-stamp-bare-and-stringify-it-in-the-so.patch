 <197308427+dangelrk@users.noreply.github.com>
Date: Sat, 26 Sep 2026 21:41:30 +0200
Subject: [PATCH] Pass the build stamp bare and stringify it in the sources

`make -f Makefile-host amiga-check` failed in ver.c with "illegal
number": vc hands its options to vbccm68k through a shell, which strips
the quotes around -DACE_BUILD_DATE='"26.09.2026"', so the date arrived
as a bare number instead of a string literal.

Makefile-host now passes ACE_BUILD_NUMBER and ACE_BUILD_DATE without
quotes, and ver.c, yap.c and bas.c turn them into strings with the
preprocessor.  That survives any number of shells in between.  Without
the defines, the fallbacks ("0" and __DATE__) are unchanged.
---
 src/ace/c/ver.c        | 19 ++++++++++++++-----
 src/bas/c/bas.c        | 21 +++++++++++++++------
 src/make/Makefile-host |  7 ++++---
 src/yap/c/yap.c        | 23 ++++++++++++++++-------
 4 files changed, 49 insertions(+), 21 deletions(-)

diff --git a/src/ace/c/ver.c b/src/ace/c/ver.c
index 37358d9..f02a2d6 100755
--- a/src/ace/c/ver.c
+++ b/src/ace/c/ver.c
@@ -47,11 +47,20 @@ static  char	*version_string = "3.1.0";
 ** Both fall back to something harmless when built without git, e.g. from
 ** an unpacked archive on a real Amiga.
 */
-#ifndef ACE_BUILD_NUMBER
-#define ACE_BUILD_NUMBER "0"
+/* The build system passes both bare (-DACE_BUILD_NUMBER=14), not as string
+** literals: vc hands its options to vbccm68k through a shell, which strips
+** the quotes, so the literal would arrive as a number.  Stringify here. */
+#define ACE_STR_(x)	#x
+#define ACE_STR(x)	ACE_STR_(x)
+#ifdef ACE_BUILD_NUMBER
+#define ACE_BUILD_NUMBER_STR ACE_STR(ACE_BUILD_NUMBER)
+#else
+#define ACE_BUILD_NUMBER_STR "0"
 #endif
-#ifndef ACE_BUILD_DATE
-#define ACE_BUILD_DATE __DATE__
+#ifdef ACE_BUILD_DATE
+#define ACE_BUILD_DATE_STR ACE_STR(ACE_BUILD_DATE)
+#else
+#define ACE_BUILD_DATE_STR __DATE__
 #endif
 
 static	char	build_string[80];
@@ -71,6 +80,6 @@ char	*version_full()
 ** "3.1.0 build 14 (11.08.2026)".
 */
 	sprintf(build_string,"%s build %s (%s)",
-		version_string,ACE_BUILD_NUMBER,ACE_BUILD_DATE);
+		version_string,ACE_BUILD_NUMBER_STR,ACE_BUILD_DATE_STR);
 	return build_string;
 }
diff --git a/src/bas/c/bas.c b/src/bas/c/bas.c
index afe1cec..1457156 100644
--- a/src/bas/c/bas.c
+++ b/src/bas/c/bas.c
@@ -54,11 +54,20 @@
 ** harmless when built without git.
 */
 #define BAS_VERSION "3.1.0"
-#ifndef ACE_BUILD_NUMBER
-#define ACE_BUILD_NUMBER "0"
+/* The build system passes both bare (-DACE_BUILD_NUMBER=14), not as string
+** literals: vc hands its options to vbccm68k through a shell, which strips
+** the quotes, so the literal would arrive as a number.  Stringify here. */
+#define ACE_STR_(x)	#x
+#define ACE_STR(x)	ACE_STR_(x)
+#ifdef ACE_BUILD_NUMBER
+#define ACE_BUILD_NUMBER_STR ACE_STR(ACE_BUILD_NUMBER)
+#else
+#define ACE_BUILD_NUMBER_STR "0"
 #endif
-#ifndef ACE_BUILD_DATE
-#define ACE_BUILD_DATE __DATE__
+#ifdef ACE_BUILD_DATE
+#define ACE_BUILD_DATE_STR ACE_STR(ACE_BUILD_DATE)
+#else
+#define ACE_BUILD_DATE_STR __DATE__
 #endif
 
 #define MAXPATH     1024
@@ -478,7 +487,7 @@ const char *to;
 static void usage()
 {
  printf("bas - ACE BASIC compile driver %s build %s (%s)\n",
-	BAS_VERSION,ACE_BUILD_NUMBER,ACE_BUILD_DATE);
+	BAS_VERSION,ACE_BUILD_NUMBER_STR,ACE_BUILD_DATE_STR);
  printf("Usage: bas [options] sourcefile[.b] [extra.o ...]\n");
  printf("\n");
  printf("Driver options:\n");
@@ -535,7 +544,7 @@ char **argv;
 	   case 'h': usage(); return(0);
 	   case 'V':
 		printf("bas %s build %s (%s)\n",
-		       BAS_VERSION,ACE_BUILD_NUMBER,ACE_BUILD_DATE);
+		       BAS_VERSION,ACE_BUILD_NUMBER_STR,ACE_BUILD_DATE_STR);
 		return(0);
 	   case 'm':
 		module = 1;
diff --git a/src/make/Makefile-host b/src/make/Makefile-host
index 1edf553..75b10a6 100644
--- a/src/make/Makefile-host
+++ b/src/make/Makefile-host
@@ -98,7 +98,8 @@ OBJ_DIR     = $(BUILD_DIR)/obj
 # header, so a rebuild never dirties the repository.
 BUILD_NUMBER := $(shell git -C $(ROOT) rev-list --count HEAD 2>/dev/null || echo 0)$(shell git -C $(ROOT) diff --quiet HEAD 2>/dev/null || echo +)
 BUILD_DATE   := $(shell date "+%d.%m.%Y")
-CFLAGS += -DACE_BUILD_NUMBER=\"$(BUILD_NUMBER)\" -DACE_BUILD_DATE=\"$(BUILD_DATE)\"
+# Passed bare, not quoted: the sources stringify them (see ver.c).
+CFLAGS += -DACE_BUILD_NUMBER=$(BUILD_NUMBER) -DACE_BUILD_DATE=$(BUILD_DATE)
 
 
 ACE_BIN = $(BUILD_DIR)/ace$(EXEEXT)
@@ -193,8 +194,8 @@ AMIGA_BIN     = $(AMIGA_DIR)/ace
 
 # Same flags as Makefile-ace.  Note: no -DACE_HOST, so the Amiga branches win.
 AMIGA_CFLAGS  = +aos68k -c -O2 -cpu=68000 \
-                -DACE_BUILD_NUMBER='"$(BUILD_NUMBER)"' \
-                -DACE_BUILD_DATE='"$(BUILD_DATE)"' \
+                -DACE_BUILD_NUMBER=$(BUILD_NUMBER) \
+                -DACE_BUILD_DATE=$(BUILD_DATE) \
                 -I$(ACE_SRC_DIR) -I$(VBCC_INC) -I$(NDK_INC)
 AMIGA_LDFLAGS = +aos68k -cpu=68000 -L$(VBCC_LIB) -L$(NDK_LIB) -lmieee -lamiga
 
