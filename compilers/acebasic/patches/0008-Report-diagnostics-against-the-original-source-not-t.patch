index 074b317..2a3f893 100644
--- a/src/yap/c/yap.c
+++ b/src/yap/c/yap.c
@@ -84,6 +84,21 @@ static char *outBuf = NULL;
 static size_t outBufLen = 0;
 static size_t outBufCap = 0;
 
+/*
+** -g: line markers.
+**
+** Comment removal, blank-line consolidation and #include all make the
+** output stop tracking the input 1:1, so a diagnostic from ace would
+** otherwise name a line of the preprocessed text - useless in an editor.
+** With -g a "#line N "FILE"" marker is emitted whenever the position
+** drifts, saying which source line the NEXT output line came from; ace
+** consumes them (see lex.c nextch()) and reports the original position.
+*/
+static int   genLineMarkers = 0;
+static char  markerFile[MAX_PATH] = "";
+static long  markerLine = 0;	/* source line ace will attribute to the
+				** next output line, per markers so far */
+
 /* ---- Shared line buffer, as in the original ---- */
 static char  rdLineBuf[MAX_LINE+1];
 
@@ -128,6 +143,8 @@ static void show_usage()
  printf("  -D<name>[=val]  Define a macro\n");
  printf("  -U<name>        Undefine a macro\n");
  printf("  -I<path>        Add include search path\n");
+ printf("  -g              Emit #line markers so ace reports positions\n");
+ printf("                  in the original source\n");
 }
 
 /*---- macro table ---------------------------------------------------------*/
@@ -202,7 +219,7 @@ size_t extra;
  outBuf = p;
 }
 
-static void output_line(ln)
+static void out_raw_line(ln)
 const char *ln;
 {
  size_t n = strlen(ln);
@@ -213,10 +230,37 @@ const char *ln;
  outBuf[outBufLen++] = '\n';
 }
 
+static void sync_line_marker()
+{
+/* Emit a marker if the next output line would not land where the reader
+** currently thinks it is. Called immediately before every emitted line. */
+ char buf[MAX_PATH+64];
+ const char *file = inclFileName[includeDepth];
+ long line = inclLineNum[includeDepth];
+
+ if (!genLineMarkers) return;
+ if (line == markerLine && strcmp(file,markerFile) == 0) return;
+
+ sprintf(buf,"#line %ld \"%s\"",line,file);
+ out_raw_line(buf);
+ copy_bounded(markerFile,file,sizeof(markerFile));
+ markerLine = line;
+}
+
+static void output_line(ln)
+const char *ln;
+{
+ sync_line_marker();
+ out_raw_line(ln);
+ markerLine++;
+}
+
 static void output_blank_line()
 {
+ sync_line_marker();
  out_reserve(1);
  outBuf[outBufLen++] = '\n';
+ markerLine++;
 }
 
 static void flush_output()
@@ -899,6 +943,10 @@ char **argv;
 		show_usage();
 		return(FALSE);
 
+	 case 'G':
+		genLineMarkers = TRUE;
+		break;
+
 	 case 'D':
 		if (a[2] == '\0')
 		   { printf("Error: -D requires a macro name\n"); return(FALSE); }
