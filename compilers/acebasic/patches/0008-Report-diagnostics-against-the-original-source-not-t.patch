+static BOOL take_line_marker(buf)
+char *buf;
+{
+/*
+** Consume a "#line N "FILE"" marker emitted by yap -g.
+**
+** Comment removal, blank-line consolidation and #include make yap's
+** output stop tracking its input 1:1, so without these markers every
+** diagnostic would name a line of the preprocessed text. On a match,
+** lineno and curfile are set so the position reported is the one in the
+** original source, and TRUE is returned to say the line is not program
+** text. '#' in column 1 cannot occur in ACE BASIC once the preprocessor
+** has run, so there is nothing to collide with.
+**
+** A malformed marker is left alone rather than guessed at - it will then
+** fail to parse as BASIC, which is the honest outcome.
+*/
+char *p,*q;
+long n;
+
+ if (strncmp(buf,"#line",5) != 0) return(FALSE);
+
+ p = buf + 5;
+ if (*p != ' ' && *p != '\t') return(FALSE);
+ while (*p == ' ' || *p == '\t') p++;
+ if (*p < '0' || *p > '9') return(FALSE);
+
+ n = strtol(p,&q,10);
+ p = q;
+ while (*p == ' ' || *p == '\t') p++;
+
+ if (*p == '"')
+ {
+	size_t len;
+	p++;
+	q = strchr(p,'"');
+	if (q == NULL) return(FALSE);
+	len = (size_t)(q - p);
+	if (len > MAXBMAPPATH-1) len = MAXBMAPPATH-1;
+	memcpy(curfile,p,len);
+	curfile[len] = '\0';
+ }
+
+ /* the marker names the line AFTER it; the caller's lineno++ adds the 1 */
+ lineno = (int)n - 1;
+ return(TRUE);
+}
+
+char *find_extension(char *path)
+{
+/*
+** Pointer to the extension of `path` (the '.' itself), or NULL if the
+** filename has none.
+**
+** Must look at the LAST dot of the LAST path component: searching for the
+** first dot anywhere in the string turned "my.prog.b" into "my.prog.b.b",
+** and a directory containing a dot ("/tmp/a.b/prog.b") broke the .s name
+** derivation as well.
+*/
+char *base,*p;
+
+ base = path;
+ for (p = path; *p != '\0'; p++)
+     if (*p == '/' || *p == ':' || *p == '\\') base = p + 1;
+
+ p = strrchr(base,'.');
+ return((p != NULL && p != base) ? p : NULL);
+}
+
 void open_files(char *source)
 {
 int  cc;
@@ -349,14 +434,12 @@ char *xtn;
  /* copy source file name */
  strcpy(srcfile,source);
 
- /* 
- ** Does source file name already have an extension (.b or .bas)? 
- ** If not, add one. 
+ /*
+ ** Does source file name already have an extension (.b or .bas)?
+ ** If not, add one.
  */
- cc=0;
- while (srcfile[cc] && srcfile[cc] != '.') cc++;
-
- xtn = &srcfile[cc];
+ xtn = find_extension(srcfile);
+ if (xtn == NULL) xtn = srcfile + strlen(srcfile);
 
  /*
  ** Allow an extension of ".bas",".BAS",
@@ -386,8 +469,9 @@ char *xtn;
  }
 
  /* copy source file name and change extension to ".s" */
- cc=0;
- while (srcfile[cc] != '.') { destfile[cc] = srcfile[cc]; cc++; }
+ xtn = find_extension(srcfile);
+ cc = xtn ? (int)(xtn - srcfile) : (int)strlen(srcfile);
+ memcpy(destfile,srcfile,(size_t)cc);
  destfile[cc] = '\0';
  strcat(destfile,".s");
 
@@ -432,6 +516,18 @@ BOOL continue_line;
   /* next line of source code */
   line[linelen] = '\0';
 
+  /* Swallow any yap -g line markers and refill from the line after. */
+  while (take_line_marker(line))
+  {
+   column = linelen = -1;
+   do
+   {
+   	line[++linelen]=(ch=getc(src));
+   }
+   while ((ch != '\n') && (ch != EOF) && (linelen < MAXLINELEN));
+   line[linelen] = '\0';
+  }
+
