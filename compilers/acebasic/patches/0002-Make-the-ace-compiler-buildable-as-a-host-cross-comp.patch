diff --git a/src/make/Makefile-host b/src/make/Makefile-host
new file mode 100644
index 0000000..506462e
--- /dev/null
+++ b/src/make/Makefile-host
@@ -0,0 +1,176 @@
+################################################################################
+# ACE Compiler Makefile - HOST (cross-compiler) build
+################################################################################
+#
+# Description:
+#   Builds the ACE toolchain as NATIVE HOST binaries (macOS / Linux / Windows),
+#   so that Amiga executables can be produced without an Amiga or an emulator.
+#
+#   This complements, and does not replace, Makefile-ace / Makefile-lib, which
+#   build ACE natively on AmigaOS with vbcc.  Both continue to work.
+#
+#   The host pipeline is:
+#
+#       prog.b -> bas -> yap -> ace -> vasmm68k_mot -> vlink -> prog
+#                                      \_____________________/
+#                                        from the vbcc toolchain ($VBCC/bin)
+#
+# Location:
+#   ACE:src/make/Makefile-host
+#
+# Usage:
+#   From src/make/ directory:
+#     make -f Makefile-host           # Build host binaries
+#     make -f Makefile-host V=1       # Verbose
+#     make -f Makefile-host clean
+#     make -f Makefile-host install   # Install into $(VBCC)
+#     make -f Makefile-host help
+#
+# Requirements:
+#   - A C compiler (clang or gcc)
+#   - GNU Make
+#   - For install/use: the vbcc toolchain in $(VBCC), providing
+#     bin/vasmm68k_mot and bin/vlink
+#
+################################################################################
+
+################################################################################
+# PLATFORM DETECTION
+################################################################################
+# Mirrors ~/Dev/amiga/makefiles/Makefile.platform so the two agree on names.
+
+ifeq ($(OS),Windows_NT)
+  PLATFORM = windows
+  EXEEXT   = .exe
+else
+  UNAME_S := $(shell uname -s)
+  ifeq ($(UNAME_S),Darwin)
+    PLATFORM = macos
+  else ifeq ($(UNAME_S),Linux)
+    PLATFORM = linux
+  else
+    # MSYS2/MinGW/Cygwin report MINGW64_NT-..., MSYS_NT-..., CYGWIN_NT-...
+    PLATFORM = windows
+    EXEEXT   = .exe
+  endif
+endif
+EXEEXT ?=
+
+################################################################################
+# CONFIGURATION
+################################################################################
+
+# Toolchain root of the vbcc cross-compiler (provides vasmm68k_mot and vlink).
+# setenv_{mac,lin,win}.sh export VBCC; fall back to the documented location.
+VBCC ?= $(HOME)/Dev/amiga
+
+CC     ?= cc
+# -std=gnu89          : the compiler sources are K&R C throughout
+# -DACE_HOST          : selects hostcompat.h over the Amiga NDK headers
+# -Werror=format      : LONG is exactly 32 bits here, so a stray %ld would
+#                       emit corrupt constants into the generated assembly.
+#                       This is the one warning class that must stay fatal.
+CFLAGS ?= -O2
+CFLAGS += -std=gnu89 -DACE_HOST -Wformat -Werror=format \
+          -Wno-deprecated-non-prototype
+
+# WARN=1 turns on -Wall.  Off by default: these are 1990s K&R sources and the
+# ~150 unused-variable/dangling-else findings are pre-existing noise that would
+# bury anything new.
+WARN = 0
+ifeq ($(WARN),1)
+  CFLAGS += -Wall
+endif
+
+LDFLAGS ?=
+LDLIBS  ?=
+
+ROOT        = ../..
+ACE_SRC_DIR = ../ace/c
+YAP_SRC_DIR = ../yap/c
+BAS_SRC_DIR = ../bas/c
+BUILD_DIR   = $(ROOT)/bin/host/$(PLATFORM)
+OBJ_DIR     = $(BUILD_DIR)/obj
+
+ACE_BIN = $(BUILD_DIR)/ace$(EXEEXT)
+YAP_BIN = $(BUILD_DIR)/yap$(EXEEXT)
+BAS_BIN = $(BUILD_DIR)/bas$(EXEEXT)
+
+# Verbose control (same convention as Makefile-ace)
+V = 0
+ifeq ($(V),1)
+  Q =
+  ECHO = @true
+else
+  Q = @
+  ECHO = @echo
+endif
+
+################################################################################
+# SOURCE FILES
+################################################################################
+
+# Same 30 modules as Makefile-ace.  lexvar.c and symvar.c are #included by
+# lex.c and sym.c respectively and must NOT be compiled separately.
+ACE_SOURCES = alloc.c assign.c basfun.c break.c codegen.c control.c \
+              declare.c event.c expr.c factor.c file.c gadget.c gfx.c \
+              invoke.c lex.c libfunc.c memory.c menu.c message.c \
+              misc.c opt.c parse.c parsevar.c print.c screen.c \
+              serial.c statement.c sub.c sym.c ver.c window.c
+
+ACE_OBJECTS = $(patsubst %.c,$(OBJ_DIR)/%.o,$(ACE_SOURCES))
+
+################################################################################
+# BUILD TARGETS
+################################################################################
+
+.PHONY: all ace yap bas clean rebuild install info help dirs
+
+all: ace
+	@echo "Host build complete: $(ACE_BIN)"
+
+ace: dirs $(ACE_BIN)
+
+$(ACE_BIN): $(ACE_OBJECTS)
+	$(ECHO) "Linking ace..."
+	$(Q)$(CC) $(LDFLAGS) $(ACE_OBJECTS) -o $@ $(LDLIBS)
+
+$(OBJ_DIR)/%.o: $(ACE_SRC_DIR)/%.c $(ACE_SRC_DIR)/acedef.h $(ACE_SRC_DIR)/hostcompat.h
+	$(ECHO) "Compiling $<..."
+	$(Q)$(CC) $(CFLAGS) -I$(ACE_SRC_DIR) -c $< -o $@
+
+dirs:
+	$(Q)mkdir -p $(OBJ_DIR)
+
+################################################################################
+# UTILITY TARGETS
+################################################################################
+
+clean:
+	$(ECHO) "Cleaning host build..."
+	$(Q)rm -rf $(BUILD_DIR)
+	@echo "Clean complete"
+
+rebuild: clean all
+
+info:
+	@echo "PLATFORM  = $(PLATFORM)"
+	@echo "CC        = $(CC)"
+	@echo "CFLAGS    = $(CFLAGS)"
+	@echo "VBCC      = $(VBCC)"
+	@echo "BUILD_DIR = $(BUILD_DIR)"
+
+help:
+	@echo "ACE host cross-compiler build (Makefile-host)"
+	@echo ""
+	@echo "Targets:"
+	@echo "  all      - Build host binaries (default)"
+	@echo "  clean    - Remove the host build directory"
+	@echo "  rebuild  - clean + all"
+	@echo "  install  - Install into \$$(VBCC) (default $(VBCC))"
+	@echo "  info     - Show detected configuration"
+	@echo ""
+	@echo "Options:"
+	@echo "  V=1      - Verbose output"
+	@echo "  CC=gcc   - Override the host compiler"
+	@echo "  VBCC=... - Override the vbcc toolchain root"
