- strcpy(bmapname,"ACEbmaps:");
+/*
+** Build the path of a library's .bmap file.
+**
+** ACE_BMAPS overrides the location, which is what host (cross-compiler)
+** builds use since there is no ACEbmaps: assign there.  Unset -> the
+** classic AmigaOS assign, so native behaviour is unchanged.
+*/
+char *dir = getenv("ACE_BMAPS");
+size_t n;
+
+ if (dir != NULL && *dir != '\0')
+ {
+	n = strlen(dir);
+	/* keep room for the separator, the library name and ".bmap" */
+	if (n > MAXBMAPPATH - MAXIDSIZE - 8) n = MAXBMAPPATH - MAXIDSIZE - 8;
+	memcpy(bmapname,dir,n);
+	bmapname[n] = '\0';
+	/* only add a separator if the setting isn't already one */
+	if (n > 0 && bmapname[n-1] != '/' && bmapname[n-1] != ':'
+		  && bmapname[n-1] != '\\')
+	   strcat(bmapname,"/");
+ }
+ else strcpy(bmapname,"ACEbmaps:");
+
  strcat(bmapname,libname);
  strcat(bmapname,".bmap");
 }
