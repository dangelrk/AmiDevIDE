diff --git a/src/ace/c/alloc.c b/src/ace/c/alloc.c
index cf00f45..ce2e33a 100755
--- a/src/ace/c/alloc.c
+++ b/src/ace/c/alloc.c
@@ -34,25 +34,84 @@
 */
 	
 #include <acedef.h>
-#include <intuition/intuition.h>
 
 /* external variables */
 extern	int	lev;
 
+/*
+** Tracked allocation list.
+**
+** This replaces Intuition's AllocRemember()/FreeRemember(), which tied the
+** compiler to intuition.library for what is really just a bump-and-forget
+** pool.  A plain malloc() chain gives the same semantics (allocate freely,
+** release everything at once) and builds on AmigaOS and on the host alike.
+*/
+typedef struct MemNode
+{
+	struct MemNode	*next;
+	void		*mem;
+} MEMNODE;
+
 /* local variables */
-struct Remember *GenRememberList = NULL;
-struct Remember *SymRememberList[2] = { NULL, NULL };
+MEMNODE *GenAllocList = NULL;
+MEMNODE *SymAllocList[2] = { NULL, NULL };
 
 /* protos */
-void *malloc();
+void *list_alloc();
+void list_free();
 
 /* functions */
+void *list_alloc(list,bytes)
+MEMNODE **list;
+ULONG	bytes;
+{
+/*
+** Allocate a zeroed block and remember it in *list.
+** Returns NULL if either the block or its bookkeeping node can't be had.
+*/
+MEMNODE *node;
+void	*mem;
+
+ if ((node=(MEMNODE *)malloc(sizeof(MEMNODE))) == NULL) return(NULL);
+
+ /* calloc(): AllocRemember() with MEMF_CLEAR was not used, but ACE relies
+ ** on fresh symbol-table nodes being zeroed, so keep it deterministic. */
+ if ((mem=calloc(1,(size_t)(bytes ? bytes : 1))) == NULL)
+ {
+	free(node);
+	return(NULL);
+ }
+
+ node->mem  = mem;
+ node->next = *list;
+ *list	    = node;
+
+ return(mem);
+}
+
+void list_free(list)
+MEMNODE **list;
+{
+/* free every block on *list and the list itself */
+MEMNODE *node,*next;
+
+ node = *list;
+ while (node != NULL)
+ {
+	next = node->next;
+	free(node->mem);
+	free(node);
+	node = next;
+ }
+ *list = NULL;
+}
+
 void *alloc(bytes,flags)
 ULONG bytes,flags;
 {
 /* allocate memory as requested */
 
- return((void *)AllocRemember(&GenRememberList,bytes,flags));     
+ return(list_alloc(&GenAllocList,bytes));
 }
 
 void *sym_alloc(bytes,flags)
@@ -60,18 +119,17 @@ ULONG bytes,flags;
 {
 /* allocate memory for current level's symbol table as requested */
 
- return((void *)AllocRemember(&SymRememberList[lev],bytes,flags));     
+ return(list_alloc(&SymAllocList[lev],bytes));
 }
 
 void free_alloc()
 {
 /* free all memory allocated by alloc */
 
- if (GenRememberList != NULL) 
+ if (GenAllocList != NULL)
  {
 	puts("freeing memory...");
-	FreeRemember(&GenRememberList,TRUE);
-	GenRememberList = NULL;
+	list_free(&GenAllocList);
  }
 }
 
@@ -79,11 +137,7 @@ void free_sym_alloc()
 {
 /* free all memory allocated by sym_alloc for current level */
 
- if (SymRememberList[lev] != NULL) 
- {
-	FreeRemember(&SymRememberList[lev],TRUE);
-	SymRememberList[lev] = NULL;
- }
+ if (SymAllocList[lev] != NULL) list_free(&SymAllocList[lev]);
 }
 
 CODE  *alloc_code(opcode,srcopr,destopr)
