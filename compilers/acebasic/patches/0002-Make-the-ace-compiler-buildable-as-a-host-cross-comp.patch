diff --git a/src/ace/c/break.c b/src/ace/c/break.c
new file mode 100644
index 0000000..b0175ea
--- /dev/null
+++ b/src/ace/c/break.c
@@ -0,0 +1,56 @@
+/*
+** break.c - user-interrupt handling for ACE.
+**
+** Deliberately does NOT include acedef.h: on the host that header's
+** declaration of ACE's own kill() (the symbol-table list killer) collides
+** with POSIX kill() from <signal.h>.  Only the two base types are needed
+** here, so pull those in directly.
+**
+** AmigaOS delivers Ctrl-C as a task signal that has to be polled; on the
+** host a SIGINT handler sets a flag.  Both are hidden behind the same pair
+** of functions so the parser and lexer don't care which platform they're on.
+*/
+
+#ifdef ACE_HOST
+
+#include "hostcompat.h"
+#include <signal.h>
+
+static volatile sig_atomic_t host_break_flag = 0;
+
+static void host_break_handler(sig)
+int sig;
+{
+ host_break_flag = 1;
+ /* re-arm: some platforms reset the disposition to SIG_DFL on delivery */
+ signal(SIGINT,host_break_handler);
+}
+
+void install_break_handler()
+{
+ signal(SIGINT,host_break_handler);
+}
+
+BOOL break_requested()
+{
+ return(host_break_flag ? TRUE : FALSE);
+}
+
+#else
+
+#include <exec/types.h>
+#include <libraries/dos.h>
+
+ULONG SetSignal();
+
+void install_break_handler()
+{
+ /* nothing to install - Ctrl-C arrives as a task signal */
+}
+
+BOOL break_requested()
+{
+ return((SetSignal(0L,SIGBREAKF_CTRL_C) & SIGBREAKF_CTRL_C) ? TRUE : FALSE);
+}
+
+#endif
