diff --git a/src/ace/c/hostcompat.h b/src/ace/c/hostcompat.h
new file mode 100644
index 0000000..292d731
--- /dev/null
+++ b/src/ace/c/hostcompat.h
@@ -0,0 +1,51 @@
+/*
+** hostcompat.h - Amiga base types for host (cross-compiler) builds of ACE.
+**
+** Included from acedef.h in place of <exec/types.h>, <exec/memory.h> and
+** <libraries/dos.h> when ACE_HOST is defined.  The native AmigaOS build is
+** unaffected and keeps using the real NDK headers.
+**
+** The widths below are NOT free to change; two places in the compiler depend
+** on them exactly:
+**
+**   acedef.h    FLOAT_BITS is a union of `float` and LONG.  A 64-bit LONG
+**               would make it emit garbage in the upper half of every
+**               single-precision constant.
+**   libfunc.c   .bmap library vector offsets are decoded as a 16-bit
+**               quantity and rely on SHORT wrapping to produce negative
+**               LVOs (e.g. 0xffe2 -> -30).
+**
+** Values match NDK 3.2 <exec/types.h> so that host and Amiga builds agree.
+*/
+
+#ifndef ACE_HOSTCOMPAT_H
+#define ACE_HOSTCOMPAT_H
+
+#include <stdint.h>
+
+typedef int8_t          BYTE;    /* signed 8-bit  */
+typedef uint8_t         UBYTE;   /* unsigned 8-bit */
+typedef int16_t         WORD;    /* signed 16-bit */
+typedef uint16_t        UWORD;   /* unsigned 16-bit */
+typedef int16_t         SHORT;   /* signed 16-bit */
+typedef uint16_t        USHORT;  /* unsigned 16-bit */
+typedef int32_t         LONG;    /* signed 32-bit */
+typedef uint32_t        ULONG;   /* unsigned 32-bit */
+typedef int16_t         BOOL;    /* sizeof(BOOL) == 2, as on AmigaOS */
+typedef unsigned char  *STRPTR;
+typedef void           *APTR;
+
+#ifndef TRUE
+#define TRUE  1
+#endif
+#ifndef FALSE
+#define FALSE 0
+#endif
+
+/* From <exec/memory.h>.  ACE only ever passes this through to alloc()/
+** sym_alloc(), which ignore it on the host. */
+#ifndef MEMF_ANY
+#define MEMF_ANY (0UL)
+#endif
+
+#endif /* ACE_HOSTCOMPAT_H */
