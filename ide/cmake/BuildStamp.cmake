# Writes AmigaIDEBuildStamp.h with the current build number and date.
#
# Run as a script (cmake -P) from a custom target so it re-evaluates on every
# build, not just at configure time. The header is only rewritten when its
# contents actually change, so an unchanged stamp does not drag the whole
# project through a recompile.
#
# The build number is the git commit count, with a trailing '+' when the
# working tree is dirty. Outside a git checkout it degrades to "0" -- the
# header is generated into the build tree, never into the source tree, so
# nothing here can dirty the repository.
#
# Expects: SRC_DIR (repository root), OUT (header path to write).

find_package(Git QUIET)

set(BUILD_NUMBER "0")
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD
        WORKING_DIRECTORY "${SRC_DIR}"
        OUTPUT_VARIABLE _count
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _rc)
    if(_rc EQUAL 0 AND _count)
        set(BUILD_NUMBER "${_count}")
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" diff --quiet HEAD
            WORKING_DIRECTORY "${SRC_DIR}"
            RESULT_VARIABLE _dirty
            ERROR_QUIET)
        if(NOT _dirty EQUAL 0)
            set(BUILD_NUMBER "${BUILD_NUMBER}+")
        endif()
    endif()
endif()

string(TIMESTAMP BUILD_DATE "%d.%m.%Y")

set(_content
"/* Generated by cmake/BuildStamp.cmake -- DO NOT EDIT, DO NOT COMMIT. */
#pragma once
#define AMIGAIDE_BUILD_NUMBER \"${BUILD_NUMBER}\"
#define AMIGAIDE_BUILD_DATE \"${BUILD_DATE}\"
")

set(_previous "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _previous)
endif()

if(NOT _previous STREQUAL _content)
    file(WRITE "${OUT}" "${_content}")
    message(STATUS "Build stamp: ${BUILD_NUMBER} (${BUILD_DATE})")
endif()
