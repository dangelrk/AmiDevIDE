# Writes toolchain/bin/amigaide as a shell launcher for the .app next to it.
#
# Run in script mode:  cmake -DDEST=<path> -P WriteBundleLauncher.cmake
#
# The bare executable cannot simply be copied here: macdeployqt rewrites its
# rpath to @executable_path/../Frameworks, which only resolves inside the
# bundle. Rather than re-signing a second copy with a patched rpath, the
# command-line entry point just execs the one inside the bundle.

if(NOT DEFINED DEST)
    message(FATAL_ERROR "WriteBundleLauncher.cmake: DEST is required")
endif()

file(WRITE "${DEST}"
"#!/bin/sh
# Generated by ide/cmake/WriteBundleLauncher.cmake -- do not edit.
# Runs the real binary inside AmigaIDE.app, whose rpath only resolves there.
exec \"$(dirname \"$0\")/AmigaIDE.app/Contents/MacOS/amigaide\" \"$@\"
")

file(CHMOD "${DEST}" PERMISSIONS
    OWNER_READ OWNER_WRITE OWNER_EXECUTE
    GROUP_READ GROUP_EXECUTE
    WORLD_READ WORLD_EXECUTE)
