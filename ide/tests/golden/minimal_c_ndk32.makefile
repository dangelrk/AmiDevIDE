# Generated by AmigaIDE -- DO NOT EDIT (regenerated on every build)
VBCC ?= /fake/toolchain
E    ?= 
VC   := $(VBCC)/bin/vc$(E)
VASM := $(VBCC)/bin/vasmm68k_mot$(E)
VLINK:= $(VBCC)/bin/vlink$(E)
VBCC_LIB := $(VBCC)/targets/m68k-amigaos/lib

OBJDIR := <PROJECT_ROOT>/build/obj
BINDIR := <PROJECT_ROOT>/bin
TARGET := <PROJECT_ROOT>/bin/demo

DEFINES := 
INCLUDES := -I/fake/toolchain/sdk/NDK_3.2/Include_H
ASINCLUDES := -I/fake/toolchain/sdk/NDK_3.2/Include_I -I/fake/toolchain/sdk/NDK_3.2/Include_H

CFLAGS  := +$(abspath build/vc.cfg) -c99 -cpu=68000 -O2 $(DEFINES) $(INCLUDES)
ASFLAGS := -Fhunk -m68000 -kick1hunks -nosym $(ASINCLUDES)
LDFLAGS := -bamigahunk -x -Bstatic -Cvbcc -nostdlib -mrel -L$(VBCC_LIB) -L/fake/toolchain/sdk/NDK_3.2/lib
STARTUP := /fake/toolchain/targets/m68k-amigaos/lib/startup.o
LDLIBS  := -lvc

OBJS := $(OBJDIR)/src/main.o $(OBJDIR)/__stack.o

all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p "$(BINDIR)"
	$(VLINK) $(LDFLAGS) $(STARTUP) $(OBJS) $(LDLIBS) -o "$@"

$(OBJDIR)/src/main.o: <PROJECT_ROOT>/src/main.c
	@mkdir -p "$(@D)"
	@echo "[1/2] main.c"
	$(VC) $(CFLAGS) -c "<PROJECT_ROOT>/src/main.c" -o "$@"

$(OBJDIR)/__stack.o: <PROJECT_ROOT>/build/__stack.c
	@mkdir -p "$(@D)"
	@echo "[2/2] __stack.c"
	$(VC) $(CFLAGS) -c "<PROJECT_ROOT>/build/__stack.c" -o "$@"

clean:
	rm -rf "$(OBJDIR)" "$(TARGET)"

.PHONY: all clean
