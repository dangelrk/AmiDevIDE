# Generated by AmigaIDE -- DO NOT EDIT (regenerated on every build)
VBCC ?= /fake/toolchain
E    ?= 
ACE  = ACE:bin/ace
YAP  = ACE:bin/yap
VASM = $(VBCC)bin/vasmm68k_mot$(E)
VLINK= $(VBCC)bin/vlink$(E)
ACE_LIB = ACElib:

OBJDIR = build/obj
BINDIR = bin
TARGET = bin/demobas

DEFINES = 
INCLUDES = "-I/fake/toolchain/sdk/NDK_3.2/Include_H"
ASINCLUDES = "-I/fake/toolchain/sdk/NDK_3.2/Include_I" "-I/fake/toolchain/sdk/NDK_3.2/Include_H"

YAPFLAGS = $(DEFINES) $(INCLUDES)
ACEFLAGS = -O
ASFLAGS = -Fhunk -m68000 -kick1hunks -nosym $(ASINCLUDES)
LDFLAGS = -bamigahunk -x -Bstatic -nostdlib -mrel "-L$(ACE_LIB)" "-L/fake/toolchain/sdk/NDK_3.2/lib"
STARTUP = $(ACE_LIB)68000/startup.lib
LDLIBS  = $(ACE_LIB)68000/db.lib $(ACE_LIB)amiga.lib $(ACE_LIB)vc.lib

OBJS = $(OBJDIR)/src/main.o

all : $(TARGET)
	@Echo "--AIDE-BUILD-OK--"

$(TARGET) : $(OBJS)
	@-makedir "$(BINDIR)"
	$(VLINK) $(LDFLAGS) $(STARTUP) $(OBJS) $(LDLIBS) -o "$@"

$(OBJDIR)/src/main.o : src/main.b
	@-makedir "$(@D)"
	@Echo "[1/1] main.b"
	$(YAP) $(YAPFLAGS) "src/main.b" "$(OBJDIR)/src/main.yap"
	Echo >"$(OBJDIR)/src/main.opt" "OPTION 2-"
	Join "$(OBJDIR)/src/main.opt" "$(OBJDIR)/src/main.yap" AS "$(OBJDIR)/src/main.b"
	$(ACE) $(ACEFLAGS) "$(OBJDIR)/src/main.b"
	$(VASM) $(ASFLAGS) -o "$@" "$(OBJDIR)/src/main.s"

clean :
	@-delete "$(OBJDIR)" all quiet
	@-delete "$(TARGET)" quiet

.PHONY : all clean
