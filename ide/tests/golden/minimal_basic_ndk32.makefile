ACE  := $(VBCC)/bin/ace$(E)
YAP  := $(VBCC)/bin/yap$(E)
VASM := $(VBCC)/bin/vasmm68k_mot$(E)
VLINK:= $(VBCC)/bin/vlink$(E)
ACE_SDK := $(VBCC)/sdk/ACE
ACE_LIB := $(ACE_SDK)/lib

OBJDIR := <PROJECT_ROOT>/build/obj
BINDIR := <PROJECT_ROOT>/bin
TARGET := <PROJECT_ROOT>/bin/demobas

DEFINES := 
INCLUDES := -I/fake/toolchain/sdk/NDK_3.2/Include_H
ASINCLUDES := -I/fake/toolchain/sdk/NDK_3.2/Include_I -I/fake/toolchain/sdk/NDK_3.2/Include_H

YAPFLAGS := -g $(DEFINES) $(INCLUDES) -I$(ACE_SDK)/include
ACEFLAGS := -2O
ASFLAGS := -Fhunk -m68020 -kick1hunks -nosym $(ASINCLUDES)
LDFLAGS := -bamigahunk -x -Bstatic -nostdlib -mrel -L$(ACE_LIB) -L/fake/toolchain/sdk/NDK_3.2/lib
