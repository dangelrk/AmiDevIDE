LDLIBS  := $(ACE_LIB)/db.lib $(ACE_LIB)/amiga.lib

OBJS := $(OBJDIR)/src/main.o

all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p "$(BINDIR)"
	$(VLINK) $(LDFLAGS) $(STARTUP) $(OBJS) $(LDLIBS) -o "$@"

$(OBJDIR)/src/main.o: <PROJECT_ROOT>/src/main.b
	@mkdir -p "$(@D)"
	@echo "[1/1] main.b"
	$(YAP) $(YAPFLAGS) "<PROJECT_ROOT>/src/main.b" "$(OBJDIR)/src/main.b"
	$(ACE) $(ACEFLAGS) "$(OBJDIR)/src/main.b"
	$(VASM) $(ASFLAGS) -o "$@" "$(OBJDIR)/src/main.s"

clean:
	rm -rf "$(OBJDIR)" "$(TARGET)"

.PHONY: all clean
