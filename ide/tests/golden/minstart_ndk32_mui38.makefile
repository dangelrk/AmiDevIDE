# Generated by AmigaIDE -- DO NOT EDIT (regenerated on every build)
VBCC ?= /fake/toolchain
E    ?= 
VC   := $(VBCC)/bin/vc$(E)
VASM := $(VBCC)/bin/vasmm68k_mot$(E)
VLINK:= $(VBCC)/bin/vlink$(E)
VBCC_LIB := $(VBCC)/targets/m68k-amigaos/lib

OBJDIR := <PROJECT_ROOT>/build/obj
BINDIR := <PROJECT_ROOT>/bin
TARGET := <PROJECT_ROOT>/bin/demoasm

DEFINES := 
INCLUDES := -I/fake/toolchain/sdk/NDK_3.2/Include_H -I/fake/toolchain/sdk/MUI_3.8/Developer/C/Include
ASINCLUDES := -I/fake/toolchain/sdk/NDK_3.2/Include_I -I/fake/toolchain/sdk/NDK_3.2/Include_H -I/fake/toolchain/sdk/MUI_3.8/Developer/C/Include

CFLAGS  := +$(abspath build/vc.cfg) -c99 -cpu=68020 -O2 -fpu=68881 $(DEFINES) $(INCLUDES)
ASFLAGS := -Fhunk -m68020 -kick1hunks -nosym $(ASINCLUDES)
LDFLAGS := -bamigahunk -x -Bstatic -Cvbcc -nostdlib -mrel -L$(VBCC_LIB) -L/fake/toolchain/sdk/NDK_3.2/lib -L/fake/toolchain/sdk/MUI_3.8/Developer/C/DLib -s -Rshort
STARTUP := /fake/toolchain/targets/m68k-amigaos/lib/minstart.o
LDLIBS  := -lvc

OBJS := $(OBJDIR)/src/main.o

all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p "$(BINDIR)"
	$(VLINK) $(LDFLAGS) $(STARTUP) $(OBJS) $(LDLIBS) -o "$@"

$(OBJDIR)/src/main.o: <PROJECT_ROOT>/src/main.s
	@mkdir -p "$(@D)"
	@echo "[1/1] main.s"
	$(VASM) $(ASFLAGS) -o "$@" "<PROJECT_ROOT>/src/main.s"

clean:
	rm -rf "$(OBJDIR)" "$(TARGET)"

.PHONY: all clean
